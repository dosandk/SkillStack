{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.client.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@shared": [
        "shared/index.ts"
      ]
    }
  },
  "include": [
    "client/src",
    "shared"
  ],
  "exclude": [
    "dist",
    "client/src/**/*.figma.tsx",
    "cli",
    "scripts",
    "functions"
  ]
}
