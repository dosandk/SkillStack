{
  "version": 1,
  "hooks": {
    "subagentStop": [
      {
        "command": "node .cursor/skills/create-github-task/hooks/validate-task-handoff.mjs",
        "timeout": 10,
        "loop_limit": 2
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/skills/create-github-task/hooks/guard-github-commands.mjs",
        "matcher": "gh",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
